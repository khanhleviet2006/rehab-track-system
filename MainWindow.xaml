<Window x:Class="AngleMonitorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ESP32 Clinical Angle Monitor" Height="760" Width="1150"
        Background="#F4F7F9" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#d1d5db" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">

            <Button x:Name="btnBack" HorizontalAlignment="Left" Background="Transparent" 
                    BorderThickness="0" Cursor="Hand" Margin="0,0,0,5" Click="btnBack_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Normal"/>
                    <TextBlock Text="Quay lại" FontSize="14" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,10">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="GÓC HIỆN TẠI" FontSize="13" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock x:Name="txtAngle" Text="--" FontSize="48" FontWeight="Black" Foreground="#2563EB"/>
                        <TextBlock Text="°" FontSize="18" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="2,0,0,8" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="SỐ LẦN TẬP (REPS)" FontSize="12" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <Button x:Name="btnResetReps" Content="↺ Reset" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#6B7280" Cursor="Hand" Click="btnResetReps_Click"/>
                    </Grid>
                    <TextBlock x:Name="txtReps" Text="0" FontSize="40" FontWeight="Black" Foreground="#1F2937"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="THỜI GIAN TẬP" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,2"/>
                            <TextBlock x:Name="txtSessionTime" Text="00:00:00" FontSize="22" FontWeight="Bold" Foreground="#1F2937"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Mức Tạ (kg)" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtDumbbellWeight" Text="5" Width="50" Height="25" TextAlignment="Center" FontWeight="Bold" FontSize="14" Background="#EFF6FF" BorderBrush="#93C5FD"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0">
                <StackPanel>
                    <TextBlock Text="ĐIỀU KHIỂN HỆ THỐNG" FontSize="12" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>

                    <TextBlock Text="Chọn cổng Bluetooth (COM):" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,2"/>
                    <Button x:Name="btnStartStop" Content="▶ Kết nối Bluetooth" Height="32" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnStartStop_Click" Margin="0,0,0,2">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock x:Name="txtStatus" Text="● Chưa kết nối" FontSize="11" Foreground="#6B7280" Margin="0,0,0,10"/>
                    <Button x:Name="btnPauseResumeGame" Content="⏸ Tạm dừng Game" Height="32" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnPauseResumeGame_Click" Margin="0,0,0,10" Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnOpenSettings" Content="⚙ CÀI ĐẶT NÂNG CAO" Height="32" Background="#6B7280" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnOpenSettings_Click" Margin="0,0,0,6">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnOpenAnalysis" Content="📊 BÁO CÁO &amp; PHÂN TÍCH" Height="32" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnOpenAnalysis_Click" Margin="0,0,0,2">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock Text="Mở cửa sổ đánh giá chi tiết" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                    <Separator Margin="0,0,0,8"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Grid.Row="0" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="THEO DÕI ĐỘNG HỌC THỜI GIAN THỰC" FontSize="14" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                            <ComboBox x:Name="cboGameType" Width="200" Margin="0,0,15,0" VerticalAlignment="Center" 
                                      Visibility="Collapsed"
                                      FontWeight="SemiBold" Foreground="#4B5563" Padding="8,4">
                                <ComboBoxItem Content="🚀 Bài tập Động (Phi thuyền)" IsSelected="True"/>
                            </ComboBox>

                            <Border Background="#E5E7EB" CornerRadius="8" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbClinicalMode" Content="📈 Lâm sàng" IsChecked="True" 
                                                 Cursor="Hand" Checked="Mode_Changed"
                                                 Background="Transparent" BorderThickness="0" Foreground="#4B5563" FontWeight="Bold" Padding="15,6">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#2563EB"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1" Opacity="0.1"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>

                                    <RadioButton x:Name="rbGameMode" Content="🎮 Trò chơi" 
                                                 Cursor="Hand" Checked="Mode_Changed"
                                                 Background="Transparent" BorderThickness="0" Foreground="#4B5563" FontWeight="Bold" Padding="15,6">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1" Opacity="0.1"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ClipToBounds="True">
                        <lvc:CartesianChart x:Name="chartAngle" 
                                            DisableAnimations="True" 
                                            AnimationsSpeed="0:0:0" 
                                            Hoverable="False" 
                                            DataTooltip="{x:Null}" 
                                            Zoom="None" Pan="None">
                            <lvc:CartesianChart.Series>
                                <lvc:LineSeries Values="{Binding AngleValues}" Title="Góc (°)" Stroke="#2563EB" StrokeThickness="3" PointGeometry="{x:Null}" Fill="#332563EB"/>
                                <lvc:LineSeries Values="{Binding UpperThresholdValues}" Title="Upper" Stroke="#F97316" StrokeThickness="1.5" PointGeometry="{x:Null}" Fill="Transparent" StrokeDashArray="5"/>
                                <lvc:LineSeries Values="{Binding LowerThresholdValues}" Title="Lower" Stroke="#10B981" StrokeThickness="1.5" PointGeometry="{x:Null}" Fill="Transparent" StrokeDashArray="5"/>
                            </lvc:CartesianChart.Series>

                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Thời gian"
                                        ShowLabels="False"
                                        LabelFormatter="{Binding TimeFormatter}" 
                                        MinValue="{Binding AxisMin}" 
                                        MaxValue="{Binding AxisMax}"
                                        DisableAnimations="True">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="2" Stroke="Transparent" />
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>

                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Góc (°)" MinValue="0" MaxValue="140"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>

                        <wv2:WebView2 x:Name="webViewGame" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Grid.Row="1" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Đánh giá Tầm Vận Động (ROM)" FontSize="14" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10"/>

                    <lvc:CartesianChart Grid.Row="1" DisableAnimations="True">
                        <lvc:CartesianChart.Series>
                            <lvc:ColumnSeries Values="{Binding HistogramValues}" Fill="#6366F1" MaxColumnWidth="40" DataLabels="True"/>
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding HistogramLabels}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Số lần" MinValue="0"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>