<Window x:Class="AngleMonitorWPF.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"

        Title="Xác thực hệ thống"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="White"
        FontFamily="{DynamicResource FontPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Style="{DynamicResource DialogWindowChrome}"
            Margin="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--
                 TITLE BAR  (drag to move) -->
            <Border Grid.Row="0"
                    Style="{DynamicResource DialogTitleBar}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{DynamicResource LogoBadge}">
                        <TextBlock Text="R"
                                   Style="{DynamicResource LogoBadgeText}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Xác thực hệ thống"
                               Style="{DynamicResource DialogTitleText}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Style="{DynamicResource ButtonClose}"
                            Click="BtnClose_Click"
                            ToolTip="Đóng"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 BODY
            ══════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1"
                        Margin="32,28,32,32"
                        Orientation="Vertical">

                <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG"
                           Style="{DynamicResource DialogHeading}"/>

                <StackPanel Style="{DynamicResource FormField}">
                    <TextBlock Text="Mã số bệnh nhân (MSBN)"
                               Style="{DynamicResource TextLabel}"/>
                    <TextBox x:Name="TxtMsbn"
                             Style="{DynamicResource TextBoxBase}"
                             Height="44"/>
                </StackPanel>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="TRUY CẬP"
                            Style="{DynamicResource ButtonSecondary}"
                            Height="44"
                            Click="BtnTruyCap_Click"
                            IsDefault="True"/>

                    <Button Grid.Column="2"
                            Content="HỒ SƠ MỚI"
                            Style="{DynamicResource ButtonPrimary}"
                            Height="44"
                            Click="BtnHoSoMoi_Click"/>
                </Grid>

                <Grid Margin="0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Separator Grid.Column="0"
                               Background="{DynamicResource BrushBorderDefault}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="  hoặc  "
                               Style="{DynamicResource TextBodySecondary}"
                               VerticalAlignment="Center"/>
                    <Separator Grid.Column="2"
                               Background="{DynamicResource BrushBorderDefault}"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Style="{DynamicResource FormField}">
                    <TextBlock Text="Tìm kiếm từ danh sách:"
                               Style="{DynamicResource TextLabel}"/>

                    <Grid>
                        <TextBox Style="{DynamicResource TextBoxBase}"
                                 Padding="40,10,12,10"
                                 Height="44"
                                 Text="{Binding SearchQuery,
                                        UpdateSourceTrigger=PropertyChanged,
                                        Mode=TwoWay}"/>

                        <Path Data="M 5 5 m -3 0 a 3 3 0 1 1 6 0 a 3 3 0 1 1 -6 0 M 7.1 7.1 L 10 10"
                              Stroke="{DynamicResource BrushTextPlaceholder}"
                              StrokeThickness="1.5"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="13,0,0,0"
                              IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
                <Border CornerRadius="10"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        MaxHeight="220">
                    <DataGrid Style="{DynamicResource DataGridMedical}"
                              ItemsSource="{Binding FilteredPatients}"
                              SelectedItem="{Binding SelectedPatient,
                                             Mode=TwoWay}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MSBN"
                                               Binding="{Binding Msbn}"
                                               Width="Auto"
                                               MinWidth="80"/>
                            <DataGridTextColumn Header="Họ và Tên"
                                               Binding="{Binding FullName}"
                                               Width="*"/>
                            <DataGridTextColumn Header="Tuổi"
                                               Binding="{Binding Age}"
                                               Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </StackPanel>
        </Grid>

    </Border>
</Window>
