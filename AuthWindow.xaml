<Window x:Class="AngleMonitorWPF.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Truy cập bệnh nhân — RehabTrack" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F4F6F8" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="AccessButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1D9E75" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Border Background="White" Margin="20" Padding="28" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <Border Width="38" Height="38" CornerRadius="8" Background="#1D9E75">
                    <TextBlock Text="R" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="RehabTrack" FontSize="19" FontWeight="SemiBold" Foreground="#1A202C" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Text="Truy cập hồ sơ bệnh nhân" FontSize="22" FontWeight="Bold" Foreground="#1A202C" />
            <TextBlock Text="Nhập mã số bệnh nhân hoặc mở danh sách để chọn hồ sơ." FontSize="13" Foreground="#718096" Margin="0,6,0,20" TextWrapping="Wrap" />
            <TextBlock Text="Mã số bệnh nhân (MSBN)" FontSize="13" FontWeight="SemiBold" Foreground="#455A64" />
            <TextBox x:Name="TxtMsbn" Height="42" FontSize="14" Padding="10,8" BorderBrush="#CBD5E1" Margin="0,6,0,14" />
            <Button Content="Truy cập buổi tập" Style="{StaticResource AccessButton}" IsDefault="True" Click="BtnTruyCap_Click" />
            <Button Content="Chọn từ danh sách bệnh nhân" Click="BtnDanhSach_Click" Height="42" Margin="0,9,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#176B52" Background="#E8F5F0" BorderBrush="#1D9E75" Cursor="Hand" />
            <Button Content="Tạo hồ sơ mới" Click="BtnHoSoMoi_Click" Height="42" Margin="0,9,0,0" FontSize="14" Foreground="#2563EB" Background="White" BorderBrush="#3B82F6" Cursor="Hand" />
            <Button Content="Đóng" Click="BtnClose_Click" Height="36" Margin="0,15,0,0" Background="Transparent" BorderThickness="0" Foreground="#718096" Cursor="Hand" />
        </StackPanel>
    </Border>
</Window>
