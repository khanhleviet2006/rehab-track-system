<Window x:Class="RehabTrack.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RehabTrack – Thêm hồ sơ bệnh nhân mới"
        Height="620" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Primary teal color -->
        <SolidColorBrush x:Key="PrimaryBrush"    Color="#00897B"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#00796B"/>
        <SolidColorBrush x:Key="AccentBrush"     Color="#E0F2F1"/>
        <SolidColorBrush x:Key="TextBrush"       Color="#1A2E35"/>
        <SolidColorBrush x:Key="SubTextBrush"    Color="#607D8B"/>
        <SolidColorBrush x:Key="BorderBrush"     Color="#CFD8DC"/>
        <SolidColorBrush x:Key="ErrorBrush"      Color="#E53935"/>
        <SolidColorBrush x:Key="CardBrush"       Color="#FFFFFF"/>

        <!-- Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#455A64"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height"           Value="38"/>
            <Setter Property="Padding"          Value="10,0"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Foreground"       Value="#1A2E35"/>
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="BorderBrush"      Value="#CFD8DC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#00897B"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="#1A2E35"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height"           Value="42"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="Background"       Value="#00897B"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00796B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00695C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#B2DFDB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel Button Style -->
        <Style x:Key="BtnCancel" TargetType="Button">
            <Setter Property="Height"           Value="42"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Foreground"       Value="#455A64"/>
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#CFD8DC"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ECEFF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Form body -->
            <RowDefinition Height="72"/>
            <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#00897B" CornerRadius="0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- R logo badge -->
                <Border Grid.Column="0"
                        Width="38" Height="38"
                        Background="White"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <TextBlock Text="R"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#00897B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Thêm hồ sơ bệnh nhân mới"
                               FontSize="16" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Rehabilitation Monitoring System"
                               FontSize="11" Foreground="#B2DFDB"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ FORM BODY ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">

                <!-- Row 1: PatientID + FullName -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mã bệnh nhân (MSBN) *"/>
                        <TextBox x:Name="txtPatientID"
                                 Style="{StaticResource InputBox}"
                                 IsReadOnly="True"
                                 Background="#F1F8F7"
                                 ToolTip="Tự động tạo"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Họ và tên *"/>
                        <TextBox x:Name="txtFullName"
                                 Style="{StaticResource InputBox}"
                                 MaxLength="100"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Age + Gender -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Tuổi *"/>
                        <TextBox x:Name="txtAge"
                                 Style="{StaticResource InputBox}"
                                 MaxLength="3"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Giới tính *"/>
                        <ComboBox x:Name="cboGender"
                                  Style="{StaticResource InputCombo}">
                            <ComboBoxItem Content="Nam"  IsSelected="True"/>
                            <ComboBoxItem Content="Nữ"/>
                            <ComboBoxItem Content="Khác"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Height + Weight -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Chiều cao (cm)"/>
                        <TextBox x:Name="txtHeight"
                                 Style="{StaticResource InputBox}"
                                 MaxLength="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Cân nặng (kg)"/>
                        <TextBox x:Name="txtWeight"
                                 Style="{StaticResource InputBox}"
                                 MaxLength="6"/>
                    </StackPanel>
                </Grid>

                <!-- Row 4: Injury type (loại chấn thương) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Loại chấn thương *"/>
                    <ComboBox x:Name="cboInjury"
                              Style="{StaticResource InputCombo}">
                        <ComboBoxItem Content="Knee – ACL Tear"/>
                        <ComboBoxItem Content="Knee – Meniscus Repair"/>
                        <ComboBoxItem Content="Hip – Hip Replacement"/>
                        <ComboBoxItem Content="Shoulder – Rotator Cuff"/>
                        <ComboBoxItem Content="Ankle – Ligament Sprain"/>
                        <ComboBoxItem Content="Spine – Lower Back"/>
                        <ComboBoxItem Content="Elbow – Tennis Elbow"/>
                        <ComboBoxItem Content="Wrist – Fracture"/>
                        <ComboBoxItem Content="Khác"/>
                    </ComboBox>
                </StackPanel>

                <!-- Row 5: Injury detail (ghi chú) -->
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ghi chú / mô tả chấn thương"/>
                    <TextBox x:Name="txtInjuryDetail"
                             Height="72"
                             Padding="10,8"
                             FontSize="13"
                             Foreground="#1A2E35"
                             BorderBrush="#CFD8DC"
                             BorderThickness="1"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="500">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="White"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="#00897B"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- Error message -->
                <TextBlock x:Name="txtError"
                           Foreground="#E53935"
                           FontSize="12"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ FOOTER BUTTONS ═══ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnCancel"
                        Content="Hủy"
                        Style="{StaticResource BtnCancel}"
                        Click="BtnCancel_Click"/>

                <Button Grid.Column="2"
                        x:Name="btnSave"
                        Content="+ Lưu hồ sơ"
                        Style="{StaticResource BtnPrimary}"
                        Click="BtnSave_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
