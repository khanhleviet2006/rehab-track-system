<Window x:Class="AngleMonitorWPF.DoctorWorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
 Title="DOCTOR WORKSPACE — REHABTRACK" Width="1440" Height="920" MinWidth="1100" MinHeight="740"
 WindowStartupLocation="CenterOwner" Background="#F4F7F9" FontFamily="Segoe UI" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="4"/>
   <Setter Property="Background" Value="#E8F5F0"/><Setter Property="Foreground" Value="#176B52"/>
   <Setter Property="BorderBrush" Value="#B8DCD1"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,4,10,10"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,4,10,10"/></Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="AlternatingRowBackground" Value="#F4F8F7"/>
   <Setter Property="MinRowHeight" Value="36"/><Setter Property="SelectionMode" Value="Single"/>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
   <Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="6"/>
  </Style>
 </Window.Resources>
 <Grid x:Name="WorkspaceRoot">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#124B40" Padding="14,26">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24">
     <TextBlock Text="REHABTRACK" FontSize="22" FontWeight="Bold" Foreground="White"/>
     <TextBlock Text="KHÔNG GIAN BÁC SĨ" Foreground="#BDE6D7" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock x:Name="DoctorLabel" Foreground="White" TextWrapping="Wrap" Margin="8"/>
     <TextBlock Text="Phiên đăng nhập: 30 phút. Xác thực lại khi lưu checkbox. Thời điểm xác nhận và lịch sử: UTC." Foreground="#BDE6D7" TextWrapping="Wrap" Margin="8" FontSize="11"/>
     <Button Content="Đăng nhập lại / đổi bác sĩ" Click="Relogin_Click"/>
    </StackPanel>
    <StackPanel>
     <Button Content="Tổng quan" Tag="0" Click="Navigate_Click"/>
     <Button Content="Danh sách bệnh nhân" Tag="1" Click="Navigate_Click"/>
     <Button Content="Theo dõi ROM" Tag="2" Click="Navigate_Click"/>
     <Button Content="Mục tiêu phục hồi" Tag="3" Click="Navigate_Click"/>
     <Button Content="Xác nhận ROM" Tag="4" Click="Navigate_Click" FontWeight="Bold"/>
     <Button Content="Lịch sử và báo cáo" Tag="5" Click="Navigate_Click"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="Tải lại hồ sơ" Click="Refresh_Click"/>
    <StackPanel>
     <TextBlock Text="DOCTOR WORKSPACE — REHABTRACK" FontSize="23" FontWeight="SemiBold" Foreground="#124B40"/>
     <TextBlock Text="Theo dõi phục hồi khuỷu tay • Đo đạt và xác nhận lâm sàng được lưu riêng" Foreground="#64748B" Margin="0,6,0,8"/>
    </StackPanel>
   </DockPanel>
   <DockPanel Grid.Row="1" Margin="6,8">
    <TextBlock Text="Bệnh nhân" VerticalAlignment="Center" Margin="0,0,16,10" FontWeight="Bold"/>
    <ComboBox x:Name="PatientPicker" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
     SelectionChanged="PatientChanged" IsTextSearchEnabled="True" MinWidth="340"/>
   </DockPanel>
   <TabControl x:Name="Modules" Grid.Row="2" Background="Transparent" BorderThickness="0">
    <TabItem Header="Tổng quan">
     <StackPanel Margin="10">
      <TextBlock x:Name="PatientInfo" FontSize="18" TextWrapping="Wrap" Margin="6,20"/>
      <UniformGrid Columns="3">
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="KẾT QUẢ ĐO GẦN NHẤT" Foreground="#64748B"/><TextBlock x:Name="CurrentRom" Text="Chưa có đánh giá" FontSize="18" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MỤC TIÊU / ĐO ĐẠT" Foreground="#64748B"/><TextBlock x:Name="GoalSummary" FontSize="26" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BÁC SĨ ĐÃ XÁC NHẬN" Foreground="#64748B"/><TextBlock x:Name="ConfirmedSummary" FontSize="26" Margin="0,12,0,0"/></StackPanel></Border>
      </UniformGrid>
      <ProgressBar x:Name="TreatmentProgress" Height="16" Minimum="0" Maximum="100" Margin="6,18"/>
      <TextBlock Text="Tiến độ = số mục tiêu hiện hành đã được bác sĩ xác nhận / tổng mục tiêu. Chỉ số này không phải kết luận hồi phục hoàn toàn." TextWrapping="Wrap" Margin="6"/>
      <Border Style="{StaticResource Card}"><TextBlock TextWrapping="Wrap" LineHeight="26"
       Text="1. Chọn bệnh nhân và tạo mục tiêu phù hợp.&#10;2. Chọn mốc trong bảng xác nhận, ghi kết quả khám hoặc đánh giá buổi tập.&#10;3. Tích checkbox, ghi nhận xét, nhấn Lưu và xác thực bác sĩ.&#10;4. Khi hủy xác nhận, nhập lý do để lưu lịch sử.&#10;&#10;Gập: góc gập tăng từ 0° khi duỗi thẳng. Duỗi: mức thiếu duỗi giảm về 0° hoặc góc trong khớp tăng về 180°. Không tự suy diễn quy ước cảm biến."/></Border>
     </StackPanel>
    </TabItem>
    <TabItem Header="Bệnh nhân">
     <DockPanel Margin="10">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
       <Button Content="Thêm hồ sơ bệnh nhân" Click="AddPatient_Click"/>
       <TextBlock Text="Chọn bệnh nhân ở ô phía trên; có thể gõ mã hoặc tên." VerticalAlignment="Center" Margin="12"/>
      </StackPanel>
      <DataGrid x:Name="PatientGrid" IsReadOnly="True" SelectionChanged="PatientGridChanged">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Mã BN" Binding="{Binding PatientCode}" Width="150"/>
        <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="240"/>
        <DataGridTextColumn Header="Tuổi" Binding="{Binding Age}" Width="70"/>
        <DataGridTextColumn Header="Chấn thương" Binding="{Binding Injury}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Header="Theo dõi ROM">
     <Grid Margin="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="Góc ghi nhận theo buổi (PeakROM / AvgROM) — chưa xác minh loại vận động và quy ước góc" TextWrapping="Wrap" Margin="0,8"/>
      <lvc:CartesianChart x:Name="SessionChart" Grid.Row="1" DisableAnimations="True" LegendLocation="Top"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal">
       <TextBlock Text="Tiến triển mốc" VerticalAlignment="Center" Margin="0,0,12,10"/>
       <ComboBox x:Name="ChartMilestone" DisplayMemberPath="MilestoneId" Width="140" SelectionChanged="ChartMilestoneChanged"/>
       <TextBlock x:Name="ChartCriteria" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </StackPanel>
      <lvc:CartesianChart x:Name="ProgressChart" Grid.Row="3" DisableAnimations="True" LegendLocation="Top"/>
      <DataGrid x:Name="SessionGrid" Grid.Row="4" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Buổi" Binding="{Binding SessionId}"/>
        <DataGridTextColumn Header="Ngày tập" Binding="{Binding StartTime}" Width="180"/>
        <DataGridTextColumn Header="Peak ROM" Binding="{Binding PeakROM}"/>
        <DataGridTextColumn Header="Avg ROM" Binding="{Binding AvgROM}"/>
        <DataGridTextColumn Header="Reps" Binding="{Binding TotalReps}"/>
        <DataGridTextColumn Header="Mẫu SensorData trong cửa sổ" Binding="{Binding SensorSamples}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </TabItem>
    <TabItem Header="Mục tiêu">
     <DockPanel Margin="10">
      <StackPanel DockPanel.Dock="Bottom">
       <TextBlock x:Name="EditingLabel" Text="Mục tiêu mới" FontSize="17" FontWeight="SemiBold" Margin="0,12"/>
       <WrapPanel>
        <StackPanel Width="180"><TextBlock Text="Loại vận động"/><ComboBox x:Name="Movement" SelectedIndex="0"><ComboBoxItem Content="Gập khuỷu tay" Tag="ElbowFlexion"/><ComboBoxItem Content="Duỗi khuỷu tay" Tag="ElbowExtension"/></ComboBox></StackPanel>
        <StackPanel Width="245"><TextBlock Text="Quy ước góc"/><ComboBox x:Name="Convention" SelectedIndex="0"><ComboBoxItem Content="Chưa xác định" Tag="Unknown"/><ComboBoxItem Content="Góc gập (0° duỗi thẳng)" Tag="FlexionDegrees"/><ComboBoxItem Content="Thiếu duỗi (đạt khi giảm về 0°)" Tag="ExtensionDeficit"/><ComboBoxItem Content="Góc trong (180° duỗi thẳng)" Tag="IncludedJointAngle"/></ComboBox></StackPanel>
        <StackPanel Width="110"><TextBlock Text="Mục tiêu (°)"/><TextBox x:Name="Target"/></StackPanel>
        <StackPanel Width="100"><TextBlock Text="Sai số (°)"/><TextBox x:Name="Tolerance" Text="0"/></StackPanel>
        <StackPanel Width="100"><TextBlock Text="Số lần lặp"/><TextBox x:Name="Repetitions" Text="1"/></StackPanel>
        <StackPanel Width="110"><TextBlock Text="Giữ (giây)"/><TextBox x:Name="Hold" Text="0"/></StackPanel>
        <StackPanel Width="150"><TextBlock Text="Biên độ trở về (°)"/><TextBox x:Name="ResetDelta" Text="10"/></StackPanel>
        <StackPanel Width="150"><TextBlock Text="Mất mẫu tối đa (s)"/><TextBox x:Name="MaxGap" Text="0.5"/></StackPanel>
       </WrapPanel>
       <TextBlock Text="Lý do thêm / điều chỉnh mục tiêu"/><TextBox x:Name="GoalReason" MaxLength="1200"/>
       <StackPanel Orientation="Horizontal"><Button Content="Mục tiêu mới" Click="NewGoal_Click"/><Button Content="Lưu mục tiêu" Click="SaveGoal_Click"/></StackPanel>
      </StackPanel>
      <DataGrid x:Name="GoalGrid" IsReadOnly="True" SelectionChanged="GoalSelected">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Mốc" Binding="{Binding MilestoneId}"/>
        <DataGridTextColumn Header="Vận động" Binding="{Binding MovementLabel}" Width="150"/>
        <DataGridTextColumn Header="Mục tiêu °" Binding="{Binding TargetAngle}"/>
        <DataGridTextColumn Header="Quy ước" Binding="{Binding ConventionLabel}" Width="160"/>
        <DataGridTextColumn Header="Sai số" Binding="{Binding Tolerance}"/>
        <DataGridTextColumn Header="Số lần" Binding="{Binding RequiredRepetitions}"/>
        <DataGridTextColumn Header="Giữ (s)" Binding="{Binding RequiredHoldSeconds}"/>
        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Header="Xác nhận ROM">
     <Grid Margin="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Chọn một dòng để đánh giá. Tích hoặc bỏ tích checkbox, nhập nhận xét/lý do rồi Lưu. Đánh giá đo đạt không tự tạo xác nhận bác sĩ." TextWrapping="Wrap" Margin="0,8"/>
      <DataGrid x:Name="ConfirmationGrid" Grid.Row="1" SelectionChanged="ConfirmationSelected">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Xác nhận" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <CheckBox IsChecked="{Binding IsConfirmed,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Mốc" Binding="{Binding MilestoneId}" IsReadOnly="True"/>
        <DataGridTextColumn Header="Vận động" Binding="{Binding MovementLabel}" IsReadOnly="True" Width="130"/>
        <DataGridTextColumn Header="Quy ước" Binding="{Binding ConventionLabel}" IsReadOnly="True" Width="135"/>
        <DataGridTextColumn Header="Mục tiêu °" Binding="{Binding TargetAngle}" IsReadOnly="True"/>
        <DataGridTextColumn Header="Đo được °" Binding="{Binding MeasuredAngle}" IsReadOnly="True"/>
        <DataGridTextColumn Header="Ngày đo" Binding="{Binding MeasurementTime,StringFormat=dd/MM/yyyy HH:mm}" IsReadOnly="True" Width="140"/>
        <DataGridTextColumn Header="Buổi tập" Binding="{Binding SessionId}" IsReadOnly="True"/>
        <DataGridTextColumn Header="Trạng thái đo" Binding="{Binding EvidenceLabel}" IsReadOnly="True" Width="150"/>
        <DataGridTextColumn Header="Bác sĩ" Binding="{Binding DoctorName}" IsReadOnly="True" Width="140"/>
        <DataGridTextColumn Header="Xác nhận (UTC)" Binding="{Binding ConfirmedAt,StringFormat=dd/MM/yyyy HH:mm}" IsReadOnly="True" Width="145"/>
        <DataGridTextColumn Header="Nguồn đo" Binding="{Binding MeasurementSource}" IsReadOnly="True" Width="180"/>
        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" IsReadOnly="True" Width="280"/>
       </DataGrid.Columns>
      </DataGrid>
      <TabControl Grid.Row="2" Margin="0,10,0,0">
       <TabItem Header="Khám lâm sàng">
        <StackPanel Margin="10">
         <TextBlock x:Name="AssessmentTarget" Text="Chọn mốc ở bảng phía trên" TextWrapping="Wrap" FontWeight="Bold"/>
         <WrapPanel Margin="0,8,0,0">
          <StackPanel Width="110"><TextBlock Text="Góc đo (°)"/><TextBox x:Name="ClinicalAngle"/></StackPanel>
          <StackPanel Width="100"><TextBlock Text="Số lần đạt"/><TextBox x:Name="ClinicalReps" Text="1"/></StackPanel>
          <StackPanel Width="110"><TextBlock Text="Giữ mỗi lần (s)"/><TextBox x:Name="ClinicalHold" Text="0"/></StackPanel>
          <StackPanel Width="180"><TextBlock Text="Thời gian đo"/><TextBox x:Name="ClinicalTime" ToolTip="yyyy-MM-dd HH:mm:ss (giờ máy)"/></StackPanel>
          <StackPanel Width="250"><TextBlock Text="Nguồn / dụng cụ đo"/><TextBox x:Name="ClinicalSource" MaxLength="180"/></StackPanel>
         </WrapPanel>
         <TextBlock Text="Nhận xét và lý do dùng kết quả khám lâm sàng"/><TextBox x:Name="ClinicalReason" MaxLength="1500"/>
         <Button Content="Lưu kết quả khám (chưa xác nhận mốc)" Click="SaveClinical_Click" HorizontalAlignment="Left"/>
        </StackPanel>
       </TabItem>
       <TabItem Header="Đánh giá dữ liệu buổi tập">
        <StackPanel Margin="10">
         <TextBlock Text="Chỉ chọn các xác minh dưới đây khi đã kiểm tra thực tế thiết bị và dữ liệu của buổi tập đã chọn. Các giá trị này không được suy ra từ PeakROM." TextWrapping="Wrap"/>
         <ComboBox x:Name="SessionPicker" DisplayMemberPath="DisplayName" SelectedValuePath="SessionId"/>
         <WrapPanel><CheckBox x:Name="ConventionVerified" Content="Đã xác minh vận động và quy ước của mốc đang chọn" Margin="4"/><CheckBox x:Name="QualityVerified" Content="Dữ liệu / hiệu chuẩn hợp lệ" Margin="4"/><CheckBox x:Name="HoldSupported" Content="Đủ dữ liệu thời gian giữ" Margin="4"/></WrapPanel>
         <TextBlock Text="Ghi rõ cách xác minh, hiệu chuẩn, chất lượng dữ liệu"/><TextBox x:Name="SensorReviewNotes" MaxLength="1200"/>
         <Button Content="Đánh giá chuỗi dữ liệu (chưa xác nhận mốc)" Click="EvaluateSession_Click" HorizontalAlignment="Left"/>
        </StackPanel>
       </TabItem>
      </TabControl>
      <StackPanel Grid.Row="3" Margin="0,12,0,0">
       <TextBlock Text="Nhận xét xác nhận / lý do hủy (bắt buộc cho các checkbox thay đổi)"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Lưu xác nhận của bác sĩ" Click="SaveConfirmations_Click" FontWeight="Bold"/><TextBox x:Name="ConfirmationReason" MaxLength="2000" MinWidth="250"/></DockPanel>
      </StackPanel>
     </Grid>
    </TabItem>
    <TabItem Header="Lịch sử / báo cáo">
     <Grid Margin="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><Button Content="Mở lịch sử, biểu đồ và xuất PDF" Click="OpenAnalysis_Click"/><TextBlock Text="Thời gian xác nhận/lịch sử: UTC. Ngày đo: theo giờ dữ liệu gốc." VerticalAlignment="Center" Margin="10"/></StackPanel>
      <DataGrid x:Name="AuditGrid" Grid.Row="1" IsReadOnly="True" Margin="0,10">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Lịch sử #" Binding="{Binding AuditId}"/>
        <DataGridTextColumn Header="Mốc" Binding="{Binding MilestoneId}"/>
        <DataGridTextColumn Header="Xác nhận #" Binding="{Binding ConfirmationId}"/>
        <DataGridTextColumn Header="Thao tác" Binding="{Binding Action}" Width="130"/>
        <DataGridTextColumn Header="Bác sĩ" Binding="{Binding DoctorName}" Width="150"/>
        <DataGridTextColumn Header="Thời điểm (UTC)" Binding="{Binding ChangedAt,StringFormat=dd/MM/yyyy HH:mm:ss}" Width="170"/>
        <DataGridTextColumn Header="Lý do / thay đổi mục tiêu" Binding="{Binding Reason}" Width="*" MinWidth="220"/>
       </DataGrid.Columns>
      </DataGrid>
      <DataGrid x:Name="AssessmentGrid" Grid.Row="2" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Đánh giá #" Binding="{Binding AssessmentId}"/>
        <DataGridTextColumn Header="Mốc / phiên bản" Binding="{Binding MilestoneId}"/>
        <DataGridTextColumn Header="Phiên bản" Binding="{Binding MilestoneRevision}"/>
        <DataGridTextColumn Header="Ngày đo" Binding="{Binding MeasurementTime,StringFormat=dd/MM/yyyy HH:mm:ss}" Width="170"/>
        <DataGridTextColumn Header="Mục tiêu °" Binding="{Binding TargetAngle}"/>
        <DataGridTextColumn Header="Đo °" Binding="{Binding MeasuredAngle}"/>
        <DataGridTextColumn Header="Trạng thái đo" Binding="{Binding AssessmentLabel}" Width="160"/>
        <DataGridTextColumn Header="Buổi tập" Binding="{Binding SessionId}"/>
        <DataGridTextColumn Header="Nguồn" Binding="{Binding MeasurementSource}" Width="190"/>
        <DataGridTextColumn Header="Số chu kỳ đạt" Binding="{Binding AchievedRepetitions}"/>
        <DataGridTextColumn Header="Người đánh giá" Binding="{Binding ReviewedBy}" Width="160"/>
        <DataGridTextColumn Header="Nhận xét / bằng chứng" Binding="{Binding Notes}" Width="360"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </TabItem>
   </TabControl>
   <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#176B52" TextWrapping="Wrap" Margin="6,12,6,0"/>
  </Grid>
 </Grid>
</Window>
